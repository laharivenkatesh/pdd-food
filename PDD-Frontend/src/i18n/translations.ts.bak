export type LanguageCode = 
  | 'en' | 'hi' | 'te' | 'ta' | 'kn' | 'mr' | 'bn' 
  | 'ml' | 'gu' | 'pa' | 'or' | 'ur' 
  | 'es' | 'fr' | 'ar' | 'de';

export interface LanguageOption {
  code: LanguageCode;
  label: string;
  nativeLabel: string;
  flag: string;
}

